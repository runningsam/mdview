{
  "name": "mdview",
  "version": "1.0.0",
  "description": "Markdown preview service - upload .md files and get shareable URLs",
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev --compatibility-flag nodejs_compat",
    "deploy": "npm run build:css && wrangler pages deploy",
    "build": "npm run build:css",
    "build:css": "tailwindcss -i ./src/input.css -o ./public/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./public/tailwind.css --watch"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "marked": "^15.0.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250310.0",
    "tailwindcss": "^3.4.19",
    "wrangler": "^4.0.0"
  }
}
